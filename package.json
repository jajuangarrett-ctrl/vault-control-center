{
  "name": "vault-control-center",
  "version": "0.3.7",
  "description": "Native Obsidian dashboard for operating a structured vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "keywords": [
    "obsidian-plugin",
    "obsidian",
    "dashboard",
    "vault-management"
  ],
  "author": "Franklin Garrett",
  "license": "MIT",
  "dependencies": {
    "@netlify/blobs": "^10.7.12"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "builtin-modules": "3.3.0",
    "esbuild": "0.28.1",
    "obsidian": "1.13.1",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "vitest": "4.1.10"
  }
}
